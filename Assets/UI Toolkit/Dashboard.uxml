<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Dashboard.uss?fileID=7433441132597879392&amp;guid=aac05523f1b5ae0499ce6378ee2cbf79&amp;type=3#Dashboard"/>
    <ui:VisualElement name="DashBoardRoot" class="dashboard-root" style="flex-grow: 1;">
        <ui:VisualElement name="DashBoardPanel" class="dashboard-panel" style="flex-grow: 1; width: auto; max-width: 100%; max-height: 100%; flex-shrink: 1;">
            <ui:VisualElement name="Header" class="dashboard-header" style="flex-grow: 1;">
                <ui:Label text="⚓" name="HeaderIcon" class="header-icon"/>
                <ui:Label text="DIGITAL TWIN MISSION CONTROL PANEL" name="HeaderTexta" class="header-title"/>
            </ui:VisualElement>
            <ui:VisualElement name="MetaDataSection" class="metadata-section" style="flex-grow: 1;">
                <ui:Label text="Asset Name: NEREUS11_XLUVV" name="AssetName" class="metadata-label"/>
                <ui:Label text="BOM Status: Verified (Open CASCADE 8.0)" name="BOMStatus" class="metadata-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="TelemetrySection" class="telemetry-section" style="flex-grow: 1;">
                <ui:Label text="📊 LIVE METRICS (Polling: 500ms)" name="TelemetryTitle" parse-escape-sequences="true" class="telemetry-title"/>
                <ui:Label text="Depth: -------- meters" name="DepthLabel" class="metric-label"/>
                <ui:Label text="Hull Pressure: -- ATM" name="PressureLabel" class="metric-label"/>
                <ui:Label text="Core Temp: -- °C" name="TemperatureLabel" class="metric-label"/>
            </ui:VisualElement>
            <ui:VisualElement name="StatusSection" class="status-section" style="flex-grow: 1;">
                <ui:Label text="⚠" name="WarningIcon" class="warning-icon"/>
                <ui:Label text="SYSTEM STATUS:" name="StatusTitle" class="status-title"/>
                <ui:Label text="OPERATIONAL / WARNING / CRITICAL" name="StatusValue" class="status-operational status-value"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
